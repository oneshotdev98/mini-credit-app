# Public site URL (no trailing slash). Use APP_URL on the server so invite emails are not stuck on localhost.
# Set APP_URL=https://your-domain.com in Vercel Production (SMTP / server reads this at runtime).
APP_URL=http://localhost:3000

# Optional: client-side absolute URLs. Defaults to APP_URL if unset in many setups.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Nodemailer — omit SMTP_HOST to skip SMTP and log invite links to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mini Credit App <noreply@example.com>"

# Submission alerts to the vendor (requires SMTP_HOST). If unset, notices go to the console only.
VENDOR_NOTIFICATION_EMAIL=
