# Base URL for links in emails (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Nodemailer — omit SMTP_HOST to skip SMTP and log invite links to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mini Credit App <noreply@example.com>"

# Submission alerts to the vendor (requires SMTP_HOST). If unset, notices go to the console only.
VENDOR_NOTIFICATION_EMAIL=
